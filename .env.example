# ---------------------------------------------------------------------------
# Supabase — publiek. Deze twee worden bij elke request naar de browser
# gestuurd (zie src/components/PublicEnvScript.tsx), niet tijdens de build
# ingebakken. Daardoor werkt dezelfde build op elke omgeving.
# ---------------------------------------------------------------------------
SUPABASE_URL=https://qidnrhdjekhnaypnusvv.supabase.co
SUPABASE_ANON_KEY=sb_publishable_...

# ---------------------------------------------------------------------------
# Supabase — GEHEIM. Uitsluitend serverside. Nooit met NEXT_PUBLIC_ prefixen
# en in Netlify aanvinken als "secret". Deze sleutel omzeilt alle RLS-policies.
# ---------------------------------------------------------------------------
SUPABASE_SERVICE_ROLE_KEY=

# ---------------------------------------------------------------------------
# Site. Laat leeg op Netlify: dan valt hij terug op de door Netlify gezette
# URL. Zet hem wel expliciet zodra je een eigen domein hebt, anders staan er
# *.netlify.app-adressen in je sitemap en JSON-LD.
# ---------------------------------------------------------------------------
SITE_URL=http://localhost:3000

# ---------------------------------------------------------------------------
# Notificaties — met `supabase secrets set` op de Edge Function zetten,
# niet hier.
# ---------------------------------------------------------------------------
RESEND_API_KEY=
NOTIFY_FROM_EMAIL="Afspraken <afspraken@jouwdomein.nl>"
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_FROM_NUMBER=
TWILIO_WHATSAPP_FROM=
CRON_SECRET=

# ---------------------------------------------------------------------------
# Legacy: de NEXT_PUBLIC_-varianten werken nog als fallback voor `npm run dev`.
# NEXT_PUBLIC_SUPABASE_URL=
# NEXT_PUBLIC_SUPABASE_ANON_KEY=
# NEXT_PUBLIC_SITE_URL=
# ---------------------------------------------------------------------------
